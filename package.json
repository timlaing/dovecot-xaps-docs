{
  "name": "dovecot-xaps-docs",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#site\" \"#.venv\"",
    "lint:spelling": "cspell --no-progress --no-must-find-files \"docs/**/*.md\" \"*.md\"",
    "lint": "npm run format:check && npm run lint:markdown && npm run lint:spelling"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "cspell": "10.4.0",
    "markdownlint-cli2": "0.24.0"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
